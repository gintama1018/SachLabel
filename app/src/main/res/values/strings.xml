    <!-- Standards / What We Check -->
    <string name="standards_title">Truth Standards</string>
    <string name="standards_subtitle">Defined Checklist • 8 Patterns</string>
    <string name="standards_scope_header">DEFINED SCOPE • NOT UNLIMITED AI</string>
    <string name="standards_scope_desc">We check these specific front-label claims against statutory back-of-pack nutrition and ingredient tables. We don\'t guess arbitrary claims.</string>
    <string name="standards_why_title">Why only these 8?</string>
    <string name="standards_why_desc">Adding a new claim category requires establishing deterministic verification logic against label disclosure rules — not just asking an LLM to guess. We explicitly bound our scope to these 8 claim types so every check remains transparent and evidence-backed.</string>

